# ==============================================================================
# VARIABLE ASSIGNMENTS (TFVARS)
# ==============================================================================
# Copy this file to terraform.tfvars

aws_region    = "us-east-1"
project_name  = "startuptech"
environment   = "dev"
instance_type = "t3.micro"
vpc_cidr      = "10.0.0.0/16"

# Use: "curl -4 https://checkip.amazonaws.com" to get current ip
my_ip         = "your_current_ip_address/32"
key_pair_name = "aws_key_pair_name"